generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Local dev uses SQLite (zero setup). For production (Vercel), set
  // provider = "postgresql" and DATABASE_URL to a Postgres/Supabase URL,
  // then run `npx prisma migrate dev` again. See README.md.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

