// Archived resident removed from the active baseline because of death.
model Kematian {
  id             String   @id @default(cuid())
  desaId         String?
  pendudukIdAsal String?
  nik            String?
  nkk            String?
  nama           String?
  tanggal        DateTime
  penyebab       String?
  punyaAkta      String?
  nomorAkta      String?
  dataPenduduk   String
  createdBy      String?
  createdByName  String?
  createdByEmail String?
  createdAt      DateTime @default(now())

  @@index([desaId, tanggal])
  @@index([nik])
  @@index([nkk])
}

// Auditable fertility, mortality, and migration event.
model PeristiwaKependudukan {
  id             String   @id @default(cuid())
  desaId         String?
  jenis          String   // KELAHIRAN | MIGRASI_MASUK | KEMATIAN | MIGRASI_KELUAR
  tanggal        DateTime
  pendudukId     String?
  nik            String?
  nkk            String?
  nama           String?
  data           String?
  createdBy      String?
  createdByName  String?
  createdByEmail String?
  createdAt      DateTime @default(now())

  @@index([desaId, jenis, tanggal])
  @@index([pendudukId])
}

// Last successful update per resident field, used for due reminders.
model FieldUpdate {
  id         String   @id @default(cuid())
  desaId     String?
  pendudukId String
  field      String
  updatedAt  DateTime @default(now())

  @@unique([pendudukId, field])
  @@index([desaId, field, updatedAt])
}

// Digitized physical building. Occupants keep kode_bangunan in Penduduk.
model Bangunan {
  id            String   @id @default(cuid())
  desaId        String?
  kode          Int
  jenis         String   // "BERPENGHUNI" | "TIDAK_BERPENGHUNI"
  kategori      String?
  keterangan    String?
  fotoUrl       String?
  polygon       String   // GeoJSON polygon coordinates
  centroidLat   Float
  centroidLng   Float
  dusun         String?
  rw            Int?
  rt            Int?
  alamat        String?
  createdBy     String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([desaId, kode])
  @@index([desaId])
  @@index([desaId, jenis])
}

// Metadata for files stored outside PostgreSQL (private Blob/local development storage).
model MediaAsset {
  id              String   @id @default(cuid())
  desaId          String
  provider        String
  storageKey      String
  storageUrl      String
  mimeType        String
  sizeBytes       Int
  purpose         String
  originalName    String?
  uploadedBy      String
  uploadedByName  String?
  createdAt       DateTime @default(now())

  @@unique([desaId, storageKey])
  @@index([desaId, purpose, createdAt])
}

// Append-only respondent identity per occupied-building visit and period.
model SesiPendataanBangunan {
  id                String   @id @default(cuid())
  desaId            String
  bangunanId        String?
  kodeBangunan      Int
  stagingGroupId    String?
  periode           String
  namaResponden     String
  fotoRespondenUrl  String
  mediaAssetId      String
  enumeratorId      String
  enumeratorName    String
  enumeratorEmail   String?
  diisiPada         DateTime @default(now())
  supersedesId      String?
  createdAt         DateTime @default(now())

  @@index([desaId, kodeBangunan, diisiPada])
  @@index([desaId, periode])
  @@index([mediaAssetId])
  @@index([stagingGroupId])
}

// Immutable point-in-time baseline (periode T0, T1, ...).
model Snapshot {
  id        String   @id @default(cuid())
  desaId    String?
  kode      String   // "T0", "T1", ...
  urutan    Int      // 0, 1, 2, ...
  label     String?
  catatan   String?
  jumlah    Int      @default(0)
  jumlahBangunan Int @default(0)
  changeCount Int    @default(0)
  changeSummary String?
  changeActors String? // JSON proposer audit summary
  createdBy String?
  createdByName String?
  createdByEmail String?
  createdAt DateTime @default(now())
  rows      SnapshotPenduduk[]
  buildingRows SnapshotBangunan[]

  @@unique([desaId, kode])
  @@unique([desaId, urutan])
  @@index([desaId])
}

// Frozen copy of one digitized building inside a snapshot.
model SnapshotBangunan {
  id         String   @id @default(cuid())
  snapshotId String
  snapshot   Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  kode       Int
  jenis      String
  data       String

  @@index([snapshotId])
  @@index([kode])
}

// Frozen copy of one Penduduk row inside a snapshot.
model SnapshotPenduduk {
  id         String   @id @default(cuid())
  snapshotId String
  snapshot   Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  nik        String?
  nkk        String?
  nama       String?
  dusun      String?
  data       String   // full record as JSON

  @@index([snapshotId])
  @@index([nik])
}

// Pending change against the live baseline (Data Perubahan Sementara).
model StagingChange {
  id         String   @id @default(cuid())
  desaId     String?
  entityType String   @default("PENDUDUK") // "PENDUDUK" | "BANGUNAN"
  groupId    String?  // one building + its occupants
  aksi       String   // "CREATE" | "UPDATE" | "DELETE"
  eventType  String?  // demographic event attached to this staged change
  eventData  String?  // JSON details such as event date, origin, destination, and documents
  pendudukId String?  // target for UPDATE/DELETE
  nik        String?
  nama       String?
  ringkasan  String?
  data       String?  // proposed field values as JSON (CREATE/UPDATE)
  status     String   @default("PENDING")
  createdBy  String?
  createdByName String?
  createdByEmail String?
  createdAt  DateTime @default(now())

  @@index([status])
  @@index([desaId])
  @@index([desaId, groupId])
}

// Village profile + letterhead settings (single row).
model PengaturanDesa {
  id         String   @id @default(cuid())
  desaId     String?  @unique
  namaKepala String?
  kopBaris1  String?  // e.g. PEMERINTAH KABUPATEN ...
  kopBaris2  String?  // e.g. KECAMATAN ...
  kopBaris3  String?  // nama desa
  kopBaris4  String?  // alamat lengkap
  penutup    String?
  disclaimer String?
  updatedAt  DateTime @updatedAt
}

// Reusable letter template.
model SuratTemplate {
  id        String   @id @default(cuid())
  desaId    String?
  nama      String
  kode      String
  kategori  String
  isi       String   // body with {{placeholder}} tokens
  createdAt DateTime @default(now())

  @@index([desaId])
}

// One issued letter (for the "Surat Keluar" log).
model SuratTerbit {
  id           String   @id @default(cuid())
  desaId       String?
  nomor        String
  templateId   String?
  templateNama String?
  pendudukId   String?
  namaWarga    String?
  nik          String?
  keperluan    String?
  peristiwaId  String?
  jenisPeristiwa String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([desaId])
  @@index([desaId, peristiwaId])
}
