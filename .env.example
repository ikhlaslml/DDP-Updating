# Local dev default: SQLite, zero setup.
# For production (Vercel + Supabase/Neon/Postgres), change prisma/schema.prisma
# datasource provider to "postgresql" and set this to your Postgres connection string.
DATABASE_URL="file:./dev.db"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-32-byte-hex-string"

# Required by Auth.js in production (npm start / next build --webpack then start)
# so it trusts the request Host header. Not needed for `next dev`.
AUTH_TRUST_HOST="true"

# Used by prisma/seed.ts to create the initial login user. Optional — defaults
# to admin@ddp.local / Admin12345! if not set.
SEED_ADMIN_EMAIL="admin@ddp.local"
SEED_ADMIN_PASSWORD="Admin12345!"
