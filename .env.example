# PostgreSQL connection string (Neon/Supabase/Vercel Postgres).
# DATABASE_URL          = koneksi POOLED (untuk runtime app).
# DATABASE_URL_UNPOOLED = koneksi LANGSUNG/direct (untuk migrasi Prisma).
# Di Vercel, integrasi Neon "Connect to Project" mengisi keduanya otomatis.
# Kalau kamu hanya punya satu URL, isi keduanya dengan URL yang sama.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require"

# Prisma datasource provider. Default proyek ini: postgresql (lokal & produksi).
# Untuk memakai SQLite lokal: set "sqlite", jalankan
# `DB_PROVIDER=sqlite node scripts/build-prisma-schema.js`, DATABASE_URL="file:./dev.db".
DB_PROVIDER="postgresql"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-random-32-byte-hex-string"

# Required by Auth.js in production (npm start / next build --webpack then start)
# so it trusts the request Host header. Not needed for `next dev`.
AUTH_TRUST_HOST="true"

# Used by prisma/seed.ts to create the initial login user. Optional — defaults
# to admin@ddp.local / Admin12345! if not set.
SEED_ADMIN_EMAIL="admin@ddp.local"
SEED_ADMIN_PASSWORD="Admin12345!"

# Sumber baseline sensus. Gunakan "local" selama pilot/dummy. Pilihan "ruby"
# hanya diaktifkan setelah tim DDP memberikan kontrak endpoint dan token server.
DDP_DATA_SOURCE="local"
DDP_API_BASE_URL=""
DDP_API_TOKEN=""
DDP_API_RESIDENTS_PATH="/v1/desa/{kodeWilayah}/penduduk"
DDP_API_TIMEOUT_MS="10000"

# Private Vercel Blob store untuk foto responden/logo. Otomatis disediakan saat
# store dihubungkan ke project Vercel. Lokal memakai storage filesystem terisolasi.
BLOB_READ_WRITE_TOKEN=""
